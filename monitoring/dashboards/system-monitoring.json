    {
      "type": "row",
      "title": "Guest OS (requires Azure Monitor Agent + DCR from main.bicep)",
      "id": 18,
      "collapsed": true,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 49
      },
      "panels": [
        {
          "type": "timeseries",
          "title": "Memory used %",
          "description": "Linux: % Used Memory. Windows: % Committed Bytes In Use.",
          "id": 19,
          "datasource": {
            "type": "grafana-azure-monitor-datasource",
            "uid": "${datasource}"
          },
          "gridPos": {
            "h": 8,
            "w": 12,
            "x": 0,
            "y": 50
          },
          "targets": [
            {
              "refId": "A",
              "datasource": {
                "type": "grafana-azure-monitor-datasource",
                "uid": "${datasource}"
              },
              "queryType": "Azure Log Analytics",
              "azureLogAnalytics": {
                "query": "Perf\n| where $__timeFilter(TimeGenerated)\n| where (ObjectName == 'Memory' and CounterName in ('% Used Memory', '% Committed Bytes In Use'))\n| extend VM = tostring(split(_ResourceId, '/')[-1])\n| where VM in~ (${vm:singlequote})\n| summarize UsedPct = avg(CounterValue) by bin(TimeGenerated, $__interval), VM\n| order by TimeGenerated asc",
                "resources": [
                  "$workspace"
                ],
                "resultFormat": "time_series",
                "dashboardTime": true,
                "timeColumn": "TimeGenerated"
              }
            }
          ],
          "fieldConfig": {
            "defaults": {
              "unit": "percent",
              "custom": {
                "drawStyle": "line",
                "lineWidth": 2,
                "fillOpacity": 10,
                "showPoints": "never",
                "spanNulls": true,
                "stacking": {
                  "mode": "none",
                  "group": "A"
                },
                "thresholdsStyle": {
                  "mode": "line"
                }
              },
              "color": {
                "mode": "palette-classic"
              },
              "max": 100,
              "min": 0,
              "thresholds": {
                "mode": "absolute",
                "steps": [
                  {
                    "color": "green",
                    "value": null
                  },
                  {
                    "color": "yellow",
                    "value": 80
                  },
                  {
                    "color": "red",
                    "value": 95
                  }
                ]
              }
            },
            "overrides": []
          },
          "options": {
            "legend": {
              "displayMode": "table",
              "placement": "bottom",
              "calcs": [
                "mean",
                "max",
                "lastNotNull"
              ]
            },
            "tooltip": {
              "mode": "multi",
              "sort": "desc"
            }
          }
        },
        {
          "type": "bargauge",
          "title": "Disk free space (latest)",
          "id": 20,
          "datasource": {
            "type": "grafana-azure-monitor-datasource",
            "uid": "${datasource}"
          },
          "gridPos": {
            "h": 8,
            "w": 12,
            "x": 12,
            "y": 50
          },
          "targets": [
            {
              "refId": "A",
              "datasource": {
                "type": "grafana-azure-monitor-datasource",
                "uid": "${datasource}"
              },
              "queryType": "Azure Log Analytics",
              "azureLogAnalytics": {
                "query": "Perf\n| where $__timeFilter(TimeGenerated)\n| where ObjectName in ('Logical Disk', 'LogicalDisk') and CounterName == '% Free Space'\n| where InstanceName !in ('_Total', 'total') and InstanceName !startswith 'HarddiskVolume'\n| extend VM = tostring(split(_ResourceId, '/')[-1])\n| where VM in~ (${vm:singlequote})\n| summarize arg_max(TimeGenerated, CounterValue) by VM, Disk = InstanceName\n| project VM, Disk, FreePct = round(CounterValue, 1)\n| order by FreePct asc",
                "resources": [
                  "$workspace"
                ],
                "resultFormat": "table",
                "dashboardTime": true,
                "timeColumn": "TimeGenerated"
              }
            }
          ],
          "fieldConfig": {
            "defaults": {
              "unit": "percent",
              "min": 0,
              "max": 100,
              "thresholds": {
                "mode": "absolute",
                "steps": [
                  {
                    "color": "red",
                    "value": null
                  },
                  {
                    "color": "yellow",
                    "value": 10
                  },
                  {
                    "color": "green",
                    "value": 20
                  }
                ]
              },
              "color": {
                "mode": "thresholds"
              }
            },
            "overrides": []
          },
          "transformations": [],
          "options": {
            "displayMode": "gradient",
            "orientation": "horizontal",
            "showUnfilled": true,
            "reduceOptions": {
              "calcs": [
                "lastNotNull"
              ],
              "fields": "/^FreePct$/",
              "values": true
            }
          }
        },
        {
          "type": "table",
          "title": "Agent heartbeat",
          "id": 21,
          "datasource": {
            "type": "grafana-azure-monitor-datasource",
            "uid": "${datasource}"
          },
          "gridPos": {
            "h": 7,
            "w": 24,
            "x": 0,
            "y": 58
          },
          "targets": [
            {
              "refId": "A",
              "datasource": {
                "type": "grafana-azure-monitor-datasource",
                "uid": "${datasource}"
              },
              "queryType": "Azure Log Analytics",
              "azureLogAnalytics": {
                "query": "Heartbeat\n| where $__timeFilter(TimeGenerated)\n| extend VM = tostring(split(ResourceId, '/')[-1])\n| where VM in~ (${vm:singlequote})\n| summarize LastHeartbeat = max(TimeGenerated) by VM, OSType, Version\n| extend MinutesAgo = datetime_diff('minute', now(), LastHeartbeat)\n| order by MinutesAgo desc",
                "resources": [
                  "$workspace"
                ],
                "resultFormat": "table",
                "dashboardTime": true,
                "timeColumn": "TimeGenerated"
              }
            }
          ],
          "fieldConfig": {
            "defaults": {},
            "overrides": [
              {
                "matcher": {
                  "id": "byName",
                  "options": "MinutesAgo"
                },
                "properties": [
                  {
                    "id": "custom.cellOptions",
                    "value": {
                      "type": "color-background"
                    }
                  },
                  {
                    "id": "thresholds",
                    "value": {
                      "mode": "absolute",
                      "steps": [
                        {
                          "color": "green",
                          "value": null
                        },
                        {
                          "color": "yellow",
                          "value": 5
                        },
                        {
                          "color": "red",
                          "value": 15
                        }
                      ]
                    }
                  }
                ]
              }
            ]
          },
          "options": {
            "showHeader": true
          }
        }
      ]
    }
